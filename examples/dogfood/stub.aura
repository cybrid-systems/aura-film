; Intentionally wrong divisor so cave art is not 23:40.
(define *now-year* 2026)
(define *day-ms* 86400000)

(define (film:clock-ms year)
  (let ((ago (- *now-year* year)))
    (if (<= ago 0)
        *day-ms*
        (let ((before (quotient (* ago 80) 4)))
          (if (>= before *day-ms*) 0 (- *day-ms* before))))))

(define (show-clock year)
  (let* ((raw (film:clock-ms year))
         (shown (if (= raw *day-ms*) 0 raw))
         (whole (quotient shown 1000))
         (ms (modulo shown 1000))
         (h (quotient whole 3600))
         (rem (modulo whole 3600))
         (m (quotient rem 60))
         (s (modulo rem 60)))
    (if (< h 10) (display "0") 0) (display (number->string h))
    (display ":")
    (if (< m 10) (display "0") 0) (display (number->string m))
    (display ":")
    (if (< s 10) (display "0") 0) (display (number->string s))
    (display ".")
    (if (< ms 100) (display "0") 0)
    (if (< ms 10) (display "0") 0)
    (display (number->string ms))))

(display "BEAT id=cave clock=")
(show-clock -42974)
(newline)
(display "BEAT id=here clock=")
(show-clock 2026)
(newline)
(display "YOU ARE HERE")
(newline)
(display "FILM_M0_OK")
(newline)
